<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:background="@drawable/title_of_page_design"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backToProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/title_of_page_design"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back" />

        <TextView
            android:id="@+id/accBalTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/accountBal"
            android:gravity="center"
            android:textColor="@color/dark_blue"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardNumTextField"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/cardNum"
        android:textColor="@color/dark_gray"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Card image + balance side by side -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"

        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="86dp"
            android:layout_height="73dp"
            android:contentDescription="@string/cardNum"
            android:src="@drawable/card" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/currentBal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/currentBal"
                android:textColor="@color/dark_blue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amountMoney"
                android:textColor="@color/dark_blue"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:text="@string/accountStatus"
                android:textColor="@color/green"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/freezeBtn"
            android:background="@drawable/light_green_round_corner_button"
            android:layout_width="151dp"
            android:layout_height="51dp"
            android:layout_gravity="center"
            android:text="@string/freeze"
            android:textOff="@string/unfreeze"
            android:textOn="@string/freeze" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/refresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/title_of_page_design"
                android:contentDescription="@string/refresh"
                android:src="@drawable/refresh_page" />

            <TextView
                android:id="@+id/refreshTextView"
                android:textColor="@color/dark_blue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/refresh"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
    <Button
        android:id="@+id/viewHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@drawable/title_of_page_design"
        android:text="@string/viewTransaction"
        android:textColor="@color/dark_blue"
        android:textStyle="bold" />



    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/transactions"
        android:textColor="@color/dark_blue"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Filter buttons in one evenly spaced row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/incomingBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="@string/incoming"
            style="?android:attr/buttonBarButtonStyle"
            />

        <Button
            android:id="@+id/outgoingBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/outgoing" />

        <Button
            android:id="@+id/amountBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/amount" />
    </LinearLayout>


</LinearLayout>