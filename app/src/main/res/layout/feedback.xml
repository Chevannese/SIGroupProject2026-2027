<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/title_of_page_design"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/title_of_page_design"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back" />

        <TextView
            android:text="@string/feedback"
            android:textSize="50sp"
            android:textColor="@color/dark_blue"
            android:textStyle="bold"
            android:id="@+id/feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/title_of_page_design"
            android:contentDescription="@null"
            />

    </LinearLayout>

    <ImageView
        android:id="@+id/happy_emoji"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/happy_emoji"
        android:contentDescription="@string/Unlock_Icon"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="30dp"
        />

    <TextView
        android:text="@string/love_feedback"
        android:textSize="30sp"
        android:textColor="@color/dark_blue"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/love_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:contentDescription="@null"
        />

    <TextView
        android:text="@string/love_feedback2"
        android:textSize="20sp"
        android:textColor="@color/dark_gray"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/love_feedback2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginBottom="20dp"
        />

    <EditText
        android:id="@+id/enter_feedback"
        android:layout_width="360dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/title_of_page_design"
        android:gravity="top|start"
        android:hint="@string/feedback_here"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="16dp"
        android:textColor="#0B2A66"
        android:textColorHint="#0B2A66"
        android:layout_marginBottom="10dp"
        android:autofillHints="null"/>

    <TextView
        android:text="@string/rate_experience"
        android:textSize="30sp"
        android:textColor="@color/dark_blue"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:id="@+id/rate_experienceTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginBottom="10dp"
        />

    <RatingBar
        android:id="@+id/rating"
        style="?android:attr/ratingBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:isIndicator="false"
        android:layout_gravity="center"
        android:numStars="5"
        android:stepSize="1"
        android:rating="0" />

    <Button
        android:text="@string/submit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:id="@+id/submitBtn"
        android:layout_marginTop="10dp"
        android:background="@drawable/blue_round_corner_button"
        android:layout_marginBottom="10dp"
        />


</LinearLayout>