<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="@string/flow_name"
        android:textSize="50sp"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:id="@+id/FlowName"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="95dp"
        />

    <TextView
        android:text="@string/real_time"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:id="@+id/rtss"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <TextView
        android:text="@string/welcome"
        android:textColor="@color/dark_blue"
        android:textSize="20sp"
        android:textStyle="bold"
        android:id="@+id/wb"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        />

    <TextView
        android:text="@string/signToContinue"
        android:textColor="@color/dark_gray"
        android:textSize="14sp"
        android:textStyle="bold"
        android:id="@+id/signToContinue"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        />

    <EditText
        android:hint="@string/inputTRN"
        android:id="@+id/loginTRN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:ems="10"
        android:minHeight="48dp"
        android:inputType="number"
        android:autofillHints="username"
        />

    <EditText
        android:hint="@string/password"
        android:id="@+id/loginPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:ems="10"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:autofillHints="password"
        android:layout_marginBottom="10dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/forget_pass"
        android:id="@+id/forgetPassBtn"
        android:textColor="@color/dark_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="25dp"
        />

    <Button
        android:text="@string/login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:id="@+id/loginBtn"
        android:ems="11"
        android:background="@color/blue"
        android:layout_marginBottom="25dp"
        />

    <TextView
        android:id="@+id/orToRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/orOption"
        android:textColor="@color/dark_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        />

    <TextView
        android:text="@string/noAccount"
        android:id="@+id/registerBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/dark_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        />

</LinearLayout>