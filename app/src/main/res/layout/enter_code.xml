<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/title_of_page_design"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/title_of_page_design"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back" />

        <TextView
            android:text="@string/forget_password1"
            android:textSize="35sp"
            android:textColor="@color/dark_blue"
            android:textStyle="bold"
            android:id="@+id/FlowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/title_of_page_design"
            android:contentDescription="@null"
            />

    </LinearLayout>
    <TextView
        android:text="@string/instrPassword"
        android:textSize="15sp"
        android:textColor="@color/dark_gray"
        android:textStyle="bold"
        android:id="@+id/instrPassword"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginBottom="20dp"
        />

    <TextView
        android:text="@string/enterCode"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:id="@+id/verifyCodeTextView"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="55dp"
        />

    <EditText
        android:hint="@string/verifyCode"
        android:id="@+id/verifyCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:autofillHints="null"
        android:inputType="number"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="20dp"
        />


    <TextView
        android:text="@string/newPassword"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:id="@+id/passwordTextView"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_marginEnd="55dp"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginBottom="5dp"
        />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordLayout"
        android:layout_width="220dp"
        android:layout_gravity="center"
        android:minHeight="48dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:endIconMode="password_toggle"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#CDEEFF"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:inputType="textPassword"
            android:gravity="center"
            android:textSize="18sp"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:text="@string/confirmPass"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:id="@+id/confirmPassTextView"
        android:layout_gravity="center"
        android:layout_marginEnd="45dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginBottom="5dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordLayout3"
        android:layout_width="220dp"
        android:minHeight="48dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        app:endIconMode="password_toggle"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#CDEEFF"
        app:boxCornerRadiusTopStart="12dp"
        android:layout_marginBottom="10dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirmPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/confirmPass"
            android:inputType="textPassword"
            android:gravity="center"
            android:textSize="18sp"
            android:padding="16dp" />

    </com.google.android.material.textfield.TextInputLayout>



    <Button
        android:id="@+id/changePassBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="25dp"
        android:background="@drawable/slightly_round_corner_button"
        android:text="@string/updatePassword"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>





</LinearLayout>