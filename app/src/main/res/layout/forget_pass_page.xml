<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/title_of_page_design"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backToLoginBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"

            android:layout_gravity="start"
            android:background="@drawable/title_of_page_design"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back" />

        <TextView
            android:text="@string/forget_password1"
            android:textSize="35sp"
            android:textColor="@color/dark_blue"
            android:textStyle="bold"
            android:id="@+id/FlowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/title_of_page_design"
            android:contentDescription="@null"
            />

    </LinearLayout>



        <ImageView
            android:id="@+id/unlockIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/unlock"
            android:contentDescription="@string/Unlock_Icon"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            />

    <TextView
        android:text="@string/sen1"
        android:textSize="14sp"
        android:textColor="@color/dark_gray"
        android:textStyle="bold"
        android:id="@+id/sen1"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        />

    <TextView
        android:text="Enter Email Details"
        android:textSize="20sp"
        android:textColor="@color/dark_blue"
        android:textStyle="bold"
        android:id="@+id/emailTextField"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        />

    <EditText
        android:hint="@string/email"
        android:id="@+id/inputTrn"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:autofillHints="username"
        android:inputType="textEmailAddress"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="20dp"
        />

    <Button
        android:text="@string/sendCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:id="@+id/sendCodeBtn"
        android:background="@drawable/slightly_round_corner_button"
        android:layout_marginBottom="25dp"
        />


</LinearLayout>