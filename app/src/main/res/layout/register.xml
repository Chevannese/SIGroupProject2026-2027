<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="@string/flow_name"
        android:fontFamily="@font/strategysidefont"
        android:textSize="50sp"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:id="@+id/FlowName"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        />

    <TextView
        android:text="@string/real_time"
        android:textColor="@color/blue"
        android:textStyle="bold"
        android:id="@+id/real_time2"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />

    <TextView
        android:text="@string/createAcc"
        android:textColor="@color/dark_blue"
        android:textStyle="bold"
        android:id="@+id/createAcc"
        android:textSize="19sp"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="5dp"
        />

    <TextView
        android:text="@string/quickReg"
        android:textColor="@color/dark_gray"
        android:textStyle="bold"
        android:id="@+id/quickReg"
        android:textSize="12sp"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        />
    <EditText
        android:hint="@string/inputTRN"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/trn"
        android:ems="10"
        android:autofillHints="name"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="10dp"
        />

    <EditText
        android:hint="@string/fullName"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/name"
        android:ems="10"
        android:autofillHints="name"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="10dp"
        />



    <EditText
        android:hint="@string/email"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/reg_email"
        android:ems="10"
        android:autofillHints="emailAddress"
        android:inputType="textEmailAddress"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="10dp"
        />


    <EditText
        android:hint="@string/phone"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/reg_phone"
        android:ems="10"
        android:autofillHints="number"
        android:inputType="number"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="10dp"
        />

    <EditText
        android:hint="@string/password"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/reg_password"
        android:ems="10"
        android:autofillHints="password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="10dp"
        />

    <EditText
        android:hint="@string/confirmPass"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/reg_confirmPass"
        android:ems="10"
        android:autofillHints="password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:background="@drawable/input_fields_design"
        android:layout_marginBottom="10dp"
        />

    <Button
        android:text="@string/register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:id="@+id/registerBtn"
        android:background="@drawable/blue_round_corner_button"
        android:layout_marginBottom="10dp"
        />

    <TextView
        android:text="@string/accExist"
        android:id="@+id/accExist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/dark_blue"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        />

</LinearLayout>